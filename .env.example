# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot and follow the prompts — you'll receive a BOT_TOKEN
# 3. Start a chat with your new bot, then visit:
#    https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
#    after sending any message to the bot; the chat_id appears in the JSON
TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeFFggHHiiJJkkLLmmNNooP
TELEGRAM_CHAT_ID=987654321

# ── Location (Gumtree local scan) ─────────────────────────────────────────────
POSTCODE=LN11 9YX
RADIUS_MILES=50

# ── eBay category scan ────────────────────────────────────────────────────────
# Comma-separated eBay UK category IDs to scan for underpriced active listings.
# Common IDs:
#   293   Sound & Vision
#   58058 Computing
#   15032 Mobile Phones & Communication
#   625   Cameras & Photography
#   1249  Video Games & Consoles
#   220   Toys & Games
#   1     Collectibles
#   11700 Home & Garden
#   550   Art
#   281   Jewellery & Watches
EBAY_CATEGORY_IDS=293,58058,15032,625,1249,220,1

# Pages fetched per category per run (each page ≈ 50 listings)
EBAY_PAGES_PER_CATEGORY=2

# true = Buy It Now only (fixed price, reliable comparison)
# false = also include live auctions (price may change before you bid)
EBAY_BIN_ONLY=true

# ── Shared filtering ──────────────────────────────────────────────────────────
# Minimum markup percentage to trigger an alert (100 = double your money)
MIN_MARKUP_PCT=100
# Ignore listings below this price
MIN_PRICE=5
# Ignore listings above this price
MAX_PRICE=500

# ── Scheduler ─────────────────────────────────────────────────────────────────
CHECK_INTERVAL_MINUTES=30

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=sale_checker.db
